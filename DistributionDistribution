    <script><![CDATA[
    function InstallationCheck()
    {
        var result;
        try {
            result = system.compareVersions(system.version.ProductVersion, '14.0') >= 0;
        } catch (e) { }

        if (!result)
        {
            my.result.type = 'Fatal';
            my.result.title = system.localizedString('require-min-os-title');
            my.result.message = system.localizedString('require-min-os-message');
        }
        return result;
    }

    function getApplicationPlistPath(app_path)
    {
        var plist = app_path + '/Contents/Info.plist';

        return plist;
    }

    function getApplicationPlistDict(app_path)
    {
        var plist_path = getApplicationPlistPath(app_path);

        if ( ! system.files.fileExistsAtPath(plist_path) )
        {
            return null;
        }

        var plist_dict = system.files.plistAtPath(plist_path);

        return plist_dict;
    }

    function getApplicationPlistDictValue(app_path, key)
    {
        var plist_dict = getApplicationPlistDict(app_path);

        if ( plist_dict == null )
        {
            return null;
        }
        
        var value = getPlistDictValue(key, plist_dict);

        return value;
    }

    function getPlistDictValue(key, plist_dict)
    {
        var value = null;

        try {
            value = plist_dict[key];
        } catch (e) {
            system.log('Error reading key ' + key + ' from plist dictionary ' + plist_dict);
        }

        return value;
    }

    function getApplicationVersion(app_path)
    {
        var version = getApplicationPlistDictValue(app_path, 'CFBundleVersion');

        return version;
    }

    function compareApplicationVersions(payload_version, installed_version)
    {
        result = system.compareVersions(payload_version, installed_version);

        return result;
    }

    function isOneDriveAppStoreBuildInstalled() 
    {
        var bundle = system.files.bundleAtPath("/Applications/OneDrive.app");
        if (!bundle) 
        {
            return false;
        }
        var installedBundleIdentifier = bundle["CFBundleIdentifier"];
        if (!installedBundleIdentifier) 
        {
            return false;
        }
        if (installedBundleIdentifier != "com.microsoft.OneDrive-mac") 
        {
            return false;
        }
        return true;
    }
    
    /*
    check to see if IT admins have blocked the deployment of an app
    */
    function shouldInstall(app_key, default_value)
    {
        if (app_key == 'InstallOneDrive')
        {
            if (isOneDriveAppStoreBuildInstalled())
            {
                return false;
            }
        }
        var pref_path = '/Library/Managed Preferences/com.microsoft.office.plist';
        if ( ! system.files.fileExistsAtPath(pref_path) )
        {
            return default_value;
        }
        
        var pref_dict = system.files.plistAtPath(pref_path);
        if ( pref_dict == null )
        {
            return default_value;
        }
        
        var pref_value = getPlistDictValue(app_key, pref_dict);
        if ( pref_value == null )
        {
            return default_value;
        }

        system.log('shouldInstall returning ' + pref_value + ' for ' + app_key);
        return pref_value;
    }

    /*
    check to make sure this is a new install, or a more up-to-date version.
    functionality requested to prevent Teams call being dropped due to installer being pushed.
    */
    function shouldInstallVersion(app_key, offered_version, default_value)
    {
        system.log('shouldInstallVersion called. app_key: ' + app_key + ' with offered version: ' + offered_version );

        var app_path = 'DoNotCheck';

        if (app_key == 'InstallTeams')
        {
            app_path = '/Applications/Microsoft Teams.app';
        } else if (app_key == 'InstallWord')
        {
            app_path = '/Applications/Microsoft Word.app';
        } else if (app_key == 'InstallExcel')
        {
            app_path = '/Applications/Microsoft Excel.app';
        } else if (app_key == 'InstallPowerPoint')
        {
            app_path = '/Applications/Microsoft PowerPoint.app';
        } else if (app_key == 'InstallOneNote')
        {
            app_path = '/Applications/Microsoft OneNote.app';
        } else if (app_key == 'InstallOutlook')
        {
            app_path = '/Applications/Microsoft Outlook.app';
        } else if (app_key == 'InstallOneDrive')
        {
            app_path = '/Applications/OneDrive.app';
        } else if (app_key == 'InstallAutoUpdate')
        {
            app_path = '/Library/Application Support/Microsoft/MAU2.0/Microsoft AutoUpdate.app';
        }

        if ( app_path != 'DoNotCheck' )
        {
            if ( system.files.fileExistsAtPath(app_path) )
            {
                /*
                  Check installed version is lower than the version offered.
                */
                var installed_version = getApplicationPlistDictValue(app_path, 'CFBundleVersion');

                var result = default_value;
                try {
                    result = compareApplicationVersions(offered_version, installed_version ) > 0;
                } catch (e) { }

		if (! (result) )
		{
        		system.log('shouldInstallVersion returning ' + result + ' for ' + app_key + ' with offered version: ' + offered_version + " and installed version: " + installed_version);
		}

                return result;
            }
        }

        return default_value;
    }
    ]]></script>
